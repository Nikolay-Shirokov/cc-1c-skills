{
  "name": "Кавычка в имени и пароле пользователя базы удваивается; в «Running:» скрыта и удвоенная форма",
  "osOnly": "win32",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 1\r\n"
      }
    },
    {
      "writeFile": {
        "path": "ib/1Cv8.1CD",
        "content": "stub"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/fake.cmd",
    "-InfoBasePath",
    "{workDir}/ib",
    "-UserName",
    "Иванов \"И\"",
    "-Password",
    "a\"b",
    "-OutputFile",
    "{workDir}/out.cf"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: DESIGNER",
      "/N\"Иванов \"\"И\"\"\" /P\"a\"\"b\"",
      "ib\" /N\"***\" /P*** /DumpCfg"
    ]
  },
  "expectError": true,
  "noSnapshot": "проверяется командная строка: ARGS — что получила платформа, «Running:» — что показано"
}
