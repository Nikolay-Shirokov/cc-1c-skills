{
  "name": "Короткий пароль скрывается по ключу, а не подстрокой: цифры в путях «Running:» целы",
  "osOnly": "win32",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 1\r\n"
      }
    },
    {
      "writeFile": {
        "path": "ib1/1Cv8.1CD",
        "content": "stub"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/fake.cmd",
    "-InfoBasePath",
    "{workDir}/ib1",
    "-UserName",
    "Ад",
    "-Password",
    "1",
    "-OutputFile",
    "{workDir}/out1.cf"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: DESIGNER",
      "ib1\" /N\"***\" /P*** /DumpCfg",
      "out1.cf"
    ],
    "stdoutNotContains": [
      "ib***",
      "out***"
    ]
  },
  "expectError": true,
  "noSnapshot": "проверяется «Running:»: пароль из одного символа и имя из двух скрыты как значения ключей, цифра 1 в путях базы и выгрузки не заменена"
}
