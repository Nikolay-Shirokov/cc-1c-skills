{
  "name": "Сверка с ненайденным объектом возвращает ошибку отбора",
  "setup": "fixture:form-event-new",
  "params": {
    "extensionPath": "cfe"
  },
  "cwd": "workDir",
  "args_extra": ["-Name", "Catalog.Itmes"],
  "expectError": true,
  "expect": {
