Процедура ПриНачалеРаботыСистемы()
	Ф = ПолучитьФорму("Справочник.Items.Форма.ItemForm");
	С = "";
	Для Каждого Имя Из СтрРазделить("L1,L3,Article,SrcField1,SrcField2,PatchA_Field,PatchB_Field,SrcBtn1,PatchA_Btn,PatchB_Btn", ",") Цикл
		Эл = Ф.Элементы.Найти(Имя);
		С = С + Имя + "=" + ?(Эл = Неопределено, "<нет>", """" + Эл.Заголовок + """") + "; ";
	КонецЦикла;
	С = С + " | cmds: ";
	Для Каждого Имя Из СтрРазделить("SrcCmd1,PatchA_Cmd,PatchB_Cmd", ",") Цикл
		С = С + Имя + "=" + (Ф.Команды.Найти(Имя) <> Неопределено) + "; ";
	КонецЦикла;
	SharedModule.Отметить(С);
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
