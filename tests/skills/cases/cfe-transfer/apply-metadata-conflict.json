{
  "name": "Перенос метаданных сохраняет файлы при несовместимом типе реквизита и занятом замке регистрации",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары",
        "attributes": [
          "Артикул: String(10)",
          "Тест_Признак: Number(5,0)"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Catalog.Товары"
      }
    },
    {
      "script": "meta-edit/scripts/meta-edit",
      "args": {
        "-ObjectPath": "{workDir}/cfe/Catalogs/Товары.xml",
        "-Operation": "add-attribute",
        "-Value": "Тест_Признак: Boolean",
        "-NoValidate": true
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Catalog", "name": "Тест_LockProbe" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}/cfe" }
    },
    {
      "writeFile": {
        "path": ".cfe-transfer-registration.lock",
        "content": "existing lock"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "cwd": "workDir",
  "args_extra": [
    "-Mode",
    "transfer"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": [
      "[CONFLICT]           Catalog.Товары — 1 conflict",
      "attribute Тест_Признак (type: boolean vs decimal in config) — the type differs; object not changed",
      "next: compare the types and merge by hand",
      "registration lock exists:",
      ".cfe-transfer-registration.lock. Wait for the other transfer.",
      "=== Summary Тест: 0 transferred now, 2 conflict · 1 role, not transferred ==="
    ],
    "stdoutNotContains": [
      "Changed files:",
      "Stored data is NOT migrated"
    ],
    "fileContains": [
      {
        "file": ".cfe-transfer-registration.lock",
        "text": "existing lock"
      },
      {
        "file": "Catalogs/Товары.xml",
        "text": [
          "<Name>Тест_Признак</Name>",
          "<v8:Type>xs:decimal</v8:Type>"
        ]
      }
    ],
    "fileNotContains": [
      {
        "file": "Catalogs/Товары.xml",
        "text": [
          "<v8:Type>xs:boolean</v8:Type>"
        ]
      }
    ]
  }
}
