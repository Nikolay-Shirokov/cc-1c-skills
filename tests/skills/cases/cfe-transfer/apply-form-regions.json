{
  "name": "Свои методы модуля формы по областям: обработчик элемента шапки, элемента таблицы (область с именем таблицы без префикса создаётся), команды (из служебной области расширения — в область роли), оповещения (в ОбработчикиОповещений), служебный метод из области расширения, которая есть в конфигурации, — в неё; правки самой формы, которые навык пока не переносит, — MANUAL",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/Catalogs/Товары.xml",
        "-FormName": "ФормаЭлемента"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Catalog.Товары.Form.ФормаЭлемента"
      }
    },
    {
      "script": "form-edit/scripts/form-edit",
      "input": {
        "attributes": [
          {
            "name": "Тест_Поле",
            "type": "string(10)",
            "title": "Поле"
          },
          {
            "name": "Тест_Строки",
            "type": "ValueTable",
            "columns": [
              {
                "name": "Значение",
                "type": "string(10)"
              }
            ]
          }
        ],
        "elements": [
          {
            "input": "Тест_Поле",
            "path": "Тест_Поле",
            "title": "Поле",
            "events": {
              "OnChange": "Тест_ПолеПриИзменении"
            }
          },
          {
            "table": "Тест_Строки",
            "path": "Тест_Строки",
            "columns": [
              {
                "input": "Тест_СтрокиЗначение",
                "path": "Тест_Строки.Значение",
                "events": {
                  "OnChange": "Тест_СтрокиЗначениеПриИзменении"
                }
              }
            ]
          }
        ],
        "commands": [
          {
            "name": "Тест_Команда",
            "action": "Тест_КомандаДействие",
            "title": "Команда"
          }
        ]
      },
      "args": {
        "-FormPath": "{workDir}/cfe/Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form.xml",
        "-JsonPath": "{inputFile}"
      }
    },
    {
      "editFile": "cfe/Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form.xml",
      "replace": " callType=\"Before\"",
      "with": "",
      "all": true
    },
    {
      "writeFile": {
        "path": "cfe/Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form/Module.bsl",
        "content": "#Область ОбработчикиСобытийЭлементовШапкиФормы\n\n&НаКлиенте\nПроцедура Тест_ПолеПриИзменении(Элемент)\n\tТест_Обновить();\nКонецПроцедуры\n\n#КонецОбласти\n\n#Область СлужебныеПроцедурыИФункции\n\n&НаКлиенте\nПроцедура Тест_СтрокиЗначениеПриИзменении(Элемент)\n\tТест_Обновить();\nКонецПроцедуры\n\n&НаКлиенте\nПроцедура Тест_КомандаДействие(Команда)\n\tОповещение = Новый ОписаниеОповещения(\"Тест_ПослеВопроса\", ЭтотОбъект);\n\tПоказатьВопрос(Оповещение, \"Продолжить?\", РежимДиалогаВопрос.ДаНет);\nКонецПроцедуры\n\n&НаКлиенте\nПроцедура Тест_ПослеВопроса(Ответ, Параметры) Экспорт\n\tТест_Обновить();\nКонецПроцедуры\n\n#КонецОбласти\n\n#Область ОбработчикиКомандФормы\n\n&НаСервере\nПроцедура Тест_Обновить()\n\tСообщить(1);\nКонецПроцедуры\n\n#КонецОбласти\n"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "cwd": "workDir",
  "args_extra": [
    "-Mode",
    "transfer"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": [
      "method Тест_ПолеПриИзменении (as ПолеПриИзменении) -> region ОбработчикиСобытийЭлементовШапкиФормы",
      "method Тест_СтрокиЗначениеПриИзменении (as СтрокиЗначениеПриИзменении) -> new region ОбработчикиСобытийЭлементовТаблицыФормыСтроки",
      "method Тест_КомандаДействие (as КомандаДействие) -> region ОбработчикиКомандФормы",
      "method Тест_ПослеВопроса (as ПослеВопроса) -> region ОбработчикиОповещений",
      "method Тест_Обновить (as Обновить) -> region ОбработчикиКомандФормы"
    ],
    "fileContains": [
      {
        "file": "Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form/Module.bsl",
        "text": [
          "#Область ОбработчикиСобытийЭлементовШапкиФормы\r\n\r\n&НаКлиенте\r\nПроцедура ПолеПриИзменении(Элемент)\r\n\tОбновить();\r\nКонецПроцедуры\r\n\r\n#КонецОбласти",
          "Процедура КомандаДействие(Команда)\r\n\tОповещение = Новый ОписаниеОповещения(\"ПослеВопроса\", ЭтотОбъект);",
          "&НаСервере\r\nПроцедура Обновить()\r\n\tСообщить(1);\r\nКонецПроцедуры\r\n\r\n#КонецОбласти\r\n\r\n#Область ОбработчикиОповещений\r\n\r\n&НаКлиенте\r\nПроцедура ПослеВопроса(Ответ, Параметры) Экспорт",
          "#Область ОбработчикиСобытийЭлементовТаблицыФормыСтроки\r\n\r\n&НаКлиенте\r\nПроцедура СтрокиЗначениеПриИзменении(Элемент)"
        ]
      }
    ]
  }
}
