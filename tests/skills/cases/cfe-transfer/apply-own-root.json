{
  "name": "Собственные корневые объекты и новые формы, MXL и команды заимствованного справочника",
  "setup": "fixture:prop-positive",
  "params": { "extensionPath": "cfe" },
  "cwd": "workDir",
  "args_extra": ["-Mode", "transfer", "-Expand", "*", "-Name", "CommonModule.Тест_Частичный,CommonModule.Тест_НовыйМодуль,CommonCommand.Тест_Команда,Catalog.Тест_НовыйСправочник,Catalog.Хранилище"],
  "idempotent": true,
  "noSnapshot": "Проверяются регистрация, файлы и обработка зависимостей. Остальная выгрузка берётся из prop-positive.",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Catalog", "name": "Хранилище", "attributes": ["Примечание: String(10)"] },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": { "-ObjectPath": "{workDir}/Catalogs/Хранилище.xml", "-FormName": "Карточка" }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": { "-ConfigPath": "{workDir}", "-ExtensionPath": "{workDir}/cfe", "-Object": "Catalog.Хранилище" }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": { "-ObjectPath": "{workDir}/cfe/Catalogs/Хранилище.xml", "-FormName": "Тест_Карточка", "-SetDefault": true }
    },
    {
      "script": "meta-edit/scripts/meta-edit",
      "args": { "-ObjectPath": "{workDir}/cfe/Catalogs/Хранилище.xml", "-Operation": "add-attribute", "-Value": "Тест_Примечание: String(10)", "-NoValidate": true }
    },
    {
      "script": "form-edit/scripts/form-edit",
      "input": { "elements": [{ "input": "ПолеПримечания", "path": "Объект.Тест_Примечание" }] },
      "args": { "-FormPath": "{workDir}/cfe/Catalogs/Хранилище/Forms/Тест_Карточка/Ext/Form.xml", "-JsonPath": "{inputFile}" }
    },
    {
      "writeFile": {
        "path": "cfe/Catalogs/Хранилище/Forms/Тест_Карточка/Ext/Form/Module.bsl",
        "content": "&НаКлиенте\nФункция ПрочитатьПримечание()\n\tТест_НовыйМодуль.Запустить();\n\tВозврат Объект.Тест_Примечание;\nКонецФункции\n"
      }
    },
    {
      "script": "template-add/scripts/add-template",
      "args": { "-ObjectName": "Хранилище", "-SrcDir": "{workDir}/cfe/Catalogs", "-TemplateName": "Тест_Бланк", "-TemplateType": "SpreadsheetDocument" }
    },
    {
      "script": "meta-edit/scripts/meta-edit",
      "args": { "-ObjectPath": "{workDir}/cfe/Catalogs/Хранилище.xml", "-Operation": "add-command", "-Value": "Тест_Печать", "-NoValidate": true }
    },
    {
      "writeFile": {
        "path": "cfe/Catalogs/Хранилище/Commands/Тест_Печать/Ext/CommandModule.bsl",
        "content": "&НаКлиенте\nПроцедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)\n\tОткрытьФорму(\"Справочник.Хранилище.Форма.Тест_Карточка\");\nКонецПроцедуры\n"
      }
    },
    {
      "writeFile": { "path": ".v8-project.json", "content": "{\"devPrefix\":[\"Дораб_\"],\"cfeTransfer\":{\"vendor\":{\"addDevPrefix\":{\"objects\":false}},\"own\":{\"addDevPrefix\":{\"objects\":false}}}}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonModule", "name": "Частичный", "synonym": "Частичный", "server": true },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonModule", "name": "Тест_Частичный", "synonym": "Частичный", "server": true },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}/cfe" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonModule", "name": "Тест_НовыйМодуль", "server": true, "serverCall": true },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}/cfe" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonCommand", "name": "Тест_Команда", "group": "ActionsPanelTools" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}/cfe" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog", "name": "Тест_НовыйСправочник",
        "attributes": ["Родственный: CatalogRef.Тест_НовыйСправочник"],
        "tabularSections": [{ "name": "Позиции", "attributes": ["Количество: Number(10,2)"] }],
        "commands": [{ "name": "Проверить", "group": "FormCommandBarImportant" }]
      },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}/cfe" }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": { "-ObjectPath": "{workDir}/cfe/Catalogs/Тест_НовыйСправочник.xml", "-FormName": "ФормаЭлемента" }
    },
    {
      "script": "template-add/scripts/add-template",
      "args": { "-ObjectName": "Тест_НовыйСправочник", "-SrcDir": "{workDir}/cfe/Catalogs", "-TemplateName": "Печать", "-TemplateType": "SpreadsheetDocument" }
    },
    {
      "writeFile": {
        "path": "cfe/Catalogs/Тест_НовыйСправочник/Ext/ObjectModule.bsl",
        "content": "Функция СсылкаНаНовый() Экспорт\n\tВозврат Справочники.Тест_НовыйСправочник.ПустаяСсылка();\nКонецФункции\n"
      }
    },
    {
      "writeFile": {
        "path": "cfe/Catalogs/Тест_НовыйСправочник/Forms/ФормаЭлемента/Ext/Form/Module.bsl",
        "content": "&НаКлиенте\nПроцедура ОткрытьСвоюФорму()\n\tПуть = \"Справочник.Тест_НовыйСправочник.Форма.ФормаЭлемента\";\n\tОткрытьФорму(\"Справочник.Тест_НовыйСправочник.Форма.ФормаЭлемента\");\n\tOpenForm(\"Catalog.Тест_НовыйСправочник.Form.ФормаЭлемента\");\nКонецПроцедуры\n"
      }
    },
    {
      "writeFile": {
        "path": "CommonModules/Частичный/Ext/Module.bsl",
        "content": "Функция Первый() Экспорт\n\tВозврат 1;\nКонецФункции\n\nФункция Второй() Экспорт\n\tВозврат 2;\nКонецФункции\n"
      }
    },
    {
      "writeFile": {
        "path": "cfe/CommonModules/Тест_Частичный/Ext/Module.bsl",
        "content": "Функция Первый() Экспорт\n\tВозврат 1;\nКонецФункции\n\nФункция Второй() Экспорт\n\tВозврат 2;\nКонецФункции\n\nФункция Третий() Экспорт\n\tВозврат Первый() + Второй();\nКонецФункции\n\n// Не переносить: временная проверка\nФункция ВременныйМетод()\n\tВозврат 50;\nКонецФункции\n"
      }
    },
    {
      "writeFile": {
        "path": "cfe/CommonModules/Тест_НовыйМодуль/Ext/Module.bsl",
        "content": "Функция Запустить() Экспорт\n\tВозврат Тест_Частичный.Третий();\nКонецФункции\n"
      }
    },
    {
      "writeFile": {
        "path": "cfe/CommonCommands/Тест_Команда/Ext/CommandModule.bsl",
        "content": "&НаКлиенте\nПроцедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)\n\tТест_НовыйМодуль.Запустить();\n\tОткрытьФорму(\"Справочник.Хранилище.Форма.Тест_Карточка\");\nКонецПроцедуры\n"
      }
    }
  ],
  "expect": {
    "stdoutContains": ["2/3 methods already present", "method Третий", "own object (as НовыйМодуль)", "own object (as Команда)", "!!! Stored data is NOT migrated:", "catalog and tabular-section records"],
    "filesAbsent": ["CommonModules/Тест_Частичный.xml", "CommonModules/Тест_НовыйМодуль.xml", "CommonCommands/Тест_Команда.xml"],
    "fileNotContains": [
      { "file": "CommonModules/Частичный/Ext/Module.bsl", "text": "ВременныйМетод" }
    ],
    "fileContains": [
      { "file": "Configuration.xml", "text": ["<CommonModule>НовыйМодуль</CommonModule>", "<CommonCommand>Команда</CommonCommand>", "<Catalog>НовыйСправочник</Catalog>"] },
      { "file": "Catalogs/НовыйСправочник.xml", "text": ["cfg:CatalogRef.НовыйСправочник", "<Name>Позиции</Name>", "<Name>Количество</Name>", "<Name>Проверить</Name>", "<Form>ФормаЭлемента</Form>", "<Template>Печать</Template>"] },
      { "file": "Catalogs/НовыйСправочник/Ext/ObjectModule.bsl", "text": "Справочники.НовыйСправочник.ПустаяСсылка()" },
      { "file": "Catalogs/НовыйСправочник/Forms/ФормаЭлемента/Ext/Form.xml", "text": "cfg:CatalogObject.НовыйСправочник" },
      { "file": "Catalogs/НовыйСправочник/Forms/ФормаЭлемента/Ext/Form/Module.bsl", "text": ["ОткрытьФорму(\"Справочник.НовыйСправочник.Форма.ФормаЭлемента\")", "OpenForm(\"Catalog.НовыйСправочник.Form.ФормаЭлемента\")", "Путь = \"Справочник.Тест_НовыйСправочник.Форма.ФормаЭлемента\";"] },
      { "file": "Catalogs/Хранилище.xml", "text": ["<Form>Карточка</Form>", "<Form>Дораб_Карточка</Form>", "<Template>Бланк</Template>", "<Name>Печать</Name>", "<DefaultObjectForm>Catalog.Хранилище.Form.Карточка</DefaultObjectForm>"] },
      { "file": "Catalogs/Хранилище/Forms/Дораб_Карточка/Ext/Form.xml", "text": "<DataPath>Объект.Примечание</DataPath>" },
      { "file": "Catalogs/Хранилище/Forms/Дораб_Карточка/Ext/Form/Module.bsl", "text": ["Возврат Объект.Примечание;", "НовыйМодуль.Запустить();"] },
      { "file": "Catalogs/Хранилище/Commands/Печать/Ext/CommandModule.bsl", "text": "ОткрытьФорму(\"Справочник.Хранилище.Форма.Дораб_Карточка\")" },
      { "file": "CommonModules/Частичный/Ext/Module.bsl", "text": "Функция Третий() Экспорт" },
      { "file": "CommonModules/НовыйМодуль/Ext/Module.bsl", "text": "Возврат Частичный.Третий()" },
      { "file": "CommonCommands/Команда/Ext/CommandModule.bsl", "text": ["\tНовыйМодуль.Запустить()", "ОткрытьФорму(\"Справочник.Хранилище.Форма.Дораб_Карточка\")"] }
    ]
  }
}
