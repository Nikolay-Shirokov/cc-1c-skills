{
  "name": "Общие объекты, журналы, интеграции и дополнения заимствованных объектов",
  "setup": "fixture:prop-positive",
  "params": {
    "extensionPath": "cfe"
  },
  "cwd": "workDir",
  "args_extra": [
    "-Mode",
    "transfer",
    "-Expand",
    "*",
    "-Name",
    "CommonForm.Тест_Общая,CommonForm.Тест_Парная,CommonTemplate.Тест_Текст,CommonAttribute.Тест_Раздел,SettingsStorage.Тест_Настройки,FilterCriterion.Тест_Отбор,DocumentJournal.Тест_Журнал,Sequence.Тест_Очередность,HTTPService.Тест_Api,WebService.Тест_Web,ExternalDataSource.Тест_Внешнее,Document.Тест_Приемка,Document.ЖурналИмпорта,ChartOfCalculationTypes.СуществующиеВиды"
  ],
  "idempotent": true,
  "noSnapshot": "Проверяются дескрипторы, файлы пакетов и ссылки на фактические имена.",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {"type": "CommonForm", "name": "Тест_Общая", "usePurposes": ["PlatformApplication"]},
        {"type": "CommonForm", "name": "Тест_Парная", "usePurposes": ["PlatformApplication"]},
        {"type": "CommonTemplate", "name": "Тест_Текст", "templateType": "TextDocument"},
        {"type": "CommonAttribute", "name": "Тест_Раздел", "valueType": "Boolean", "content": ["Document.Тест_Приемка"]},
        {"type": "SettingsStorage", "name": "Тест_Настройки"},
        {"type": "FilterCriterion", "name": "Тест_Отбор", "valueType": "String(10)", "content": ["Document.Тест_Приемка.Attribute.Состояние"]},
        {"type": "DocumentJournal", "name": "Тест_Журнал", "registeredDocuments": ["Document.Тест_Приемка"]},
        {"type": "Sequence", "name": "Тест_Очередность", "documents": ["Document.Тест_Приемка"]},
        {"type": "HTTPService", "name": "Тест_Api", "rootURL": "demo", "urlTemplates": {"Health": {"template": "/health", "methods": {"Get": "GET"}}}},
        {"type": "WebService", "name": "Тест_Web", "namespace": "urn:transfer-demo", "operations": {"Query": {"returnType": "xs:string"}}},
        {"type": "ExternalDataSource", "name": "Тест_Внешнее", "tables": {"Products": {"nameInDataSource": "products", "fields": ["ID: Number(10,0)"]}}},
        {"type": "Document", "name": "Тест_Приемка", "attributes": ["Состояние: String(10)"]}
      ],
      "args": {"-JsonPath": "{inputFile}", "-OutputDir": "{workDir}/cfe"}
    },
    {"script": "meta-compile/scripts/meta-compile", "input": [{"type": "Document", "name": "ЖурналИмпорта", "attributes": ["Примечание: String(10)"]}, {"type": "ChartOfCalculationTypes", "name": "СуществующиеВиды"}], "args": {"-JsonPath": "{inputFile}", "-OutputDir": "{workDir}"}},
    {"script": "cfe-borrow/scripts/cfe-borrow", "args": {"-Object": "Document.ЖурналИмпорта", "-ConfigPath": "{workDir}", "-ExtensionPath": "{workDir}/cfe"}},
    {"script": "cfe-borrow/scripts/cfe-borrow", "args": {"-Object": "ChartOfCalculationTypes.СуществующиеВиды", "-ConfigPath": "{workDir}", "-ExtensionPath": "{workDir}/cfe"}},
    {"script": "form-add/scripts/form-add", "args": {"-ObjectPath": "{workDir}/cfe/Documents/ЖурналИмпорта.xml", "-FormName": "Тест_Карточка", "-Purpose": "Object"}},
    {"script": "meta-edit/scripts/meta-edit", "args": {"-ObjectPath": "{workDir}/cfe/Documents/ЖурналИмпорта.xml", "-Operation": "add-attribute", "-Value": "Тест_Примечание: String(10)", "-NoValidate": true}},
    {"script": "form-edit/scripts/form-edit", "args": {"-FormPath": "{workDir}/cfe/Documents/ЖурналИмпорта/Forms/Тест_Карточка/Ext/Form.xml", "-JsonPath": "{inputFile}"}, "input": {"elements": [{"input": "Примечание", "path": "Объект.Тест_Примечание"}]}},
    {"writeFile": {"path": "cfe/Documents/ЖурналИмпорта/Forms/Тест_Карточка/Ext/Form/Module.bsl", "content": "&НаКлиенте\nФункция Прочитать()\n\tВозврат Объект.Тест_Примечание;\nКонецФункции\n"}},
    {"script": "template-add/scripts/add-template", "args": {"-ObjectName": "ЖурналИмпорта", "-SrcDir": "{workDir}/cfe/Documents", "-TemplateName": "Тест_МакетПечати", "-TemplateType": "Text"}},
    {"writeFile": {"path": "cfe/Documents/ЖурналИмпорта/Templates/Тест_МакетПечати/Ext/Template.txt", "content": "Печатный макет"}},
    {"writeFile": {"path": "Documents/ЖурналИмпорта/Ext/ManagerModule.bsl", "content": "Процедура Контроль()\nКонецПроцедуры\n"}},
    {"writeFile": {"path": "cfe/Documents/ЖурналИмпорта/Ext/ManagerModule.bsl", "content": "Функция Тест_Бланк() Экспорт\n\tВозврат GetTemplate(\"Тест_МакетПечати\");\nКонецФункции\n"}},
    {"script": "cfe-transfer/scripts/cfe-transfer", "args": {"-ExtensionPath": "{workDir}/cfe", "-ConfigPath": "{workDir}", "-Mode": "transfer", "-Name": "Document.ЖурналИмпорта"}},
    {"editFile": "Documents/ЖурналИмпорта.xml", "replace": "<Form>Карточка</Form>", "with": "<Form>ПеренесеннаяКарточка</Form>"},
    {"editFile": "Documents/ЖурналИмпорта/Forms/Карточка.xml", "replace": "<Name>Карточка</Name>", "with": "<Name>ПеренесеннаяКарточка</Name>"},
    {"movePath": {"from": "Documents/ЖурналИмпорта/Forms/Карточка.xml", "to": "Documents/ЖурналИмпорта/Forms/ПеренесеннаяКарточка.xml"}},
    {"movePath": {"from": "Documents/ЖурналИмпорта/Forms/Карточка", "to": "Documents/ЖурналИмпорта/Forms/ПеренесеннаяКарточка"}},
    {"writeFile": {"path": "cfe/CommonForms/Тест_Общая/Ext/Form/Module.bsl", "content": "&НаКлиенте\nПроцедура ОткрытьПарную()\n\tOpenForm(\"CommonForm.Тест_Парная\");\nКонецПроцедуры\n"}},
    {"writeFile": {"path": "cfe/CommonForms/Тест_Парная/Ext/Form/Module.bsl", "content": "&НаКлиенте\nПроцедура ОткрытьОбщую()\n\tОткрытьФорму(\"ОбщаяФорма.Тест_Общая\");\nКонецПроцедуры\n"}},
    {"writeFile": {"path": "cfe/ChartsOfCalculationTypes/СуществующиеВиды/Ext/Predefined.xml", "content": "<PredefinedData xmlns=\"http://v8.1c.ru/8.3/xcf/predef\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:type=\"CalculationTypePredefinedItems\" version=\"2.20\"><Item id=\"3fdaade2-78d1-4ab8-8b64-459541ab21a1\"><Name>Тест_Тариф</Name><Code>02</Code><Description>Базовый тариф</Description><ActionPeriodIsBase>true</ActionPeriodIsBase><ExtensionState>Native</ExtensionState></Item></PredefinedData>"}},
    {"writeFile": {"path": "cfe/CommonTemplates/Тест_Текст/Ext/Template.txt", "content": "Example template"}}
  ],
  "expect": {
    "fileContains": [
      {"file": "Documents/ЖурналИмпорта/Forms/ПеренесеннаяКарточка.xml", "text": "<Name>ПеренесеннаяКарточка</Name>"},
      {"file": "Documents/ЖурналИмпорта/Forms/ПеренесеннаяКарточка/Ext/Form.xml", "text": "<DataPath>Объект.Примечание</DataPath>"},
      {"file": "Documents/ЖурналИмпорта/Forms/ПеренесеннаяКарточка/Ext/Form/Module.bsl", "text": "Возврат Объект.Примечание;"},
      {"file": "Documents/ЖурналИмпорта/Ext/ManagerModule.bsl", "text": "GetTemplate(\"МакетПечати\")"},
      {"file": "Documents/ЖурналИмпорта/Templates/МакетПечати/Ext/Template.txt", "text": "Печатный макет"},
      {"file": "CommonForms/Общая/Ext/Form/Module.bsl", "text": "OpenForm(\"CommonForm.Парная\")"},
      {"file": "CommonForms/Парная/Ext/Form/Module.bsl", "text": "ОткрытьФорму(\"ОбщаяФорма.Общая\")"},
      {"file": "ChartsOfCalculationTypes/СуществующиеВиды/Ext/Predefined.xml", "text": ["3fdaade2-78d1-4ab8-8b64-459541ab21a1", "<Name>Тариф</Name>"]},
      {"file": "CommonForms/Общая.xml", "text": "<Name>Общая</Name>"},
      {"file": "CommonTemplates/Текст/Ext/Template.txt", "text": "Example template"},
      {"file": "CommonAttributes/Раздел.xml", "text": "Document.Приемка"},
      {"file": "SettingsStorages/Настройки.xml", "text": "<Name>Настройки</Name>"},
      {"file": "FilterCriteria/Отбор.xml", "text": "Document.Приемка.Attribute.Состояние"},
      {"file": "DocumentJournals/Журнал.xml", "text": "Document.Приемка"},
      {"file": "Sequences/Очередность.xml", "text": "Document.Приемка"},
      {"file": "HTTPServices/Api.xml", "text": "<RootURL>demo</RootURL>"},
      {"file": "WebServices/Web.xml", "text": "urn:transfer-demo"},
      {"file": "ExternalDataSources/Внешнее/Tables/Products.xml", "text": "<Name>Products</Name>"}
    ]
  }
}
