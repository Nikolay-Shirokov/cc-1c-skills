{
  "name": "Пересекающиеся секреты маскируются целиком: удвоенная форма одного не оставляет видимым кусок другого",
  "osOnly": "win32",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\nexit /b 1\r\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/fake.cmd",
    "-InfoBasePath",
    "{workDir}/ib",
    "-UserName",
    "a\"b",
    "-Password",
    "\"b"
  ],
  "expect": {
    "stdoutContains": "/N\"***\"",
    "stdoutNotContains": [
      "/N\"a",
      "a\"b"
    ]
  },
  "expectError": true,
  "noSnapshot": "проверяется вывод «Running:», фейк молчит"
}
