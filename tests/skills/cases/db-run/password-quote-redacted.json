{
  "name": "Пароль с кавычкой не виден в выводе: в командной строке он удвоен, маскируется и эта форма",
  "osOnly": "win32",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\nexit /b 1\r\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/fake.cmd",
    "-InfoBasePath",
    "{workDir}/ib",
    "-Password",
    "a\"b"
  ],
  "expect": {
    "stdoutContains": "Running:",
    "stdoutNotContains": [
      "a\"b",
      "a\"\"b"
    ]
  },
  "expectError": true,
  "noSnapshot": "проверяется вывод «Running:», фейк ничего не печатает"
}
