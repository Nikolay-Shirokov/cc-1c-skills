{
  "name": "events строкой — ошибка «объект или список», а не событие Length",
  "params": {
    "outputPath": "DataProcessors/Тест/Forms/Форма/Ext/Form.xml"
  },
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "DataProcessor", "name": "Тест" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": { "-ObjectPath": "{workDir}/DataProcessors/Тест.xml", "-FormName": "Форма" }
    }
  ],
  "input": {
    "attributes": [ { "name": "Поле", "type": "string" } ],
    "elements": [ { "input": "Поле", "path": "Поле", "events": "OnChange" } ]
  },
  "expect": {
    "stderrContains": "events — an object"
  },
  "expectError": true
}
