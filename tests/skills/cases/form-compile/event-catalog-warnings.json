{
  "name": "События вне каталога: событие новой платформы, чужой источник таблицы, элемент без событий — предупреждения",
  "params": {
    "outputPath": "DataProcessors/Тест/Forms/Форма/Ext/Form.xml"
  },
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "DataProcessor",
        "name": "Тест"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/DataProcessors/Тест.xml",
        "-FormName": "Форма"
      }
    }
  ],
  "input": {
    "elements": [
      {
        "table": "Товары",
        "path": "Товары",
        "events": [
          "OnHover",
          {
            "event": "OnGetDataAtServer",
            "handler": "ТоварыПриПолученииДанныхНаСервере"
          }
        ],
        "columns": [
          {
            "input": "ТоварыКоличество",
            "path": "Товары.Количество"
          }
        ]
      },
      {
        "calendar": "Календарь",
        "path": "Дата",
        "events": {
          "OnActivate": "КалендарьПриАктивизации"
        }
      },
      {
        "button": "Кнопка",
        "command": "Команда",
        "events": {
          "Click": "КнопкаНажатие"
        }
      },
      {
        "pages": "Страницы",
        "children": [
          {
            "page": "Страница",
            "events": {
              "OnCurrentPageChange": "СтраницаПриСменеСтраницы"
            }
          }
        ]
      }
    ],
    "attributes": [
      {
        "name": "Объект",
        "type": "DataProcessorObject.Тест",
        "main": true
      },
      {
        "name": "Дата",
        "type": "date"
      },
      {
        "name": "Товары",
        "type": "ValueTable",
        "columns": [
          {
            "name": "Количество",
            "type": "decimal(10,3)"
          }
        ]
      }
    ],
    "commands": [
      {
        "name": "Команда",
        "action": "КомандаДействие"
      }
    ]
  },
  "expect": {
    "stdoutContains": [
      "[WARN] Event 'OnHover' of Table 'Товары' exists since platform 8.5",
      "[WARN] Event 'OnGetDataAtServer' of Table 'Товары' exists only for a table bound to DynamicList (bound to ValueTable)",
      "[WARN] Unknown event 'OnActivate' for CalendarField 'Календарь'",
      "[WARN] Button 'Кнопка' has no events in standard configurations",
      "[WARN] Page 'Страница' has no events — ignored: OnCurrentPageChange"
    ],
    "fileContains": {
      "file": "DataProcessors/Тест/Forms/Форма/Ext/Form.xml",
      "text": [
        "<Event name=\"OnHover\">ТоварыПриНаведении</Event>"
      ]
    }
  }
}
