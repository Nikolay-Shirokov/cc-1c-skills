{
  "name": "Заготовки обработчиков: событие формы, поле, таблица и её колонка, команда — каждая в своей области модуля",
  "params": {
    "outputPath": "DataProcessors/Тест/Forms/Форма/Ext/Form.xml",
    "validatePath": "DataProcessors/Тест/Forms/Форма/Ext/Form.xml"
  },
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "DataProcessor",
        "name": "Тест"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/DataProcessors/Тест.xml",
        "-FormName": "Форма"
      }
    }
  ],
  "input": {
    "events": {
      "OnCreateAtServer": "ПриСозданииНаСервере",
      "OnOpen": "ПриОткрытии"
    },
    "elements": [
      {
        "input": "Поле",
        "path": "Поле",
        "events": {
          "OnChange": "ПолеПриИзменении"
        }
      },
      {
        "table": "Товары",
        "path": "Товары",
        "events": {
          "Selection": "ТоварыВыбор"
        },
        "columns": [
          {
            "input": "ТоварыКоличество",
            "path": "Товары.Количество",
            "events": {
              "OnChange": "ТоварыКоличествоПриИзменении"
            }
          }
        ]
      }
    ],
    "attributes": [
      {
        "name": "Объект",
        "type": "DataProcessorObject.Тест",
        "main": true
      },
      {
        "name": "Поле",
        "type": "string"
      },
      {
        "name": "Товары",
        "type": "ValueTable",
        "columns": [
          {
            "name": "Количество",
            "type": "decimal(10,3)"
          }
        ]
      }
    ],
    "commands": [
      {
        "name": "Заполнить",
        "action": "Заполнить"
      }
    ]
  },
  "expect": {
    "fileContains": {
      "file": "DataProcessors/Тест/Forms/Форма/Ext/Form/Module.bsl",
      "text": [
        "#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары",
        "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)",
        "Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)",
        "Процедура Заполнить(Команда)"
      ]
    },
    "stdoutContains": [
      "  + ПриСозданииНаСервере — empty stub added, lines 3-6",
      "  + ТоварыКоличествоПриИзменении — empty stub added, lines",
      "  + Заполнить — empty stub added, lines"
    ]
  }
}
