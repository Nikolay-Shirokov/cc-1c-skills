  "input": {
    "title": "Сохранение id",
    "elements": [
      {
        "input": "Комментарий",
        "path": "Комментарий"
      },
      {
        "table": "Товары",
        "path": "Объект.Товары",
        "columns": [
          {
            "input": "ТоварыКоличество",
            "path": "Объект.Товары.Количество"
          }
        ]
      },
      {
        "input": "Новое",
        "path": "Новое"
      },
      {
        "button": "Обновить",
        "command": "Обновить"
      }
    ],
    "attributes": [
      {
        "name": "Объект",
        "type": "DataProcessorObject.СохранениеИд",
        "main": true
      },
      {
        "name": "Комментарий",
        "type": "string"
      },
      {
        "name": "Новое",
        "type": "string"
      }
    ],
    "commands": [
      {
