</AdditionSource>\r\n\t\t\t\t<ContextMenu name=\"ТоварыSearchStringContextMenu\" id=\"15\"/>\r\n\t\t\t\t<ExtendedTooltip name=\"ТоварыSearchStringExtendedTooltip\" id=\"16\"/>\r\n\t\t\t</SearchStringAddition>\r\n\t\t\t<ViewStatusAddition name=\"ТоварыViewStatus\" id=\"17\">\r\n\t\t\t\t<AdditionSource>\r\n\t\t\t\t\t<Item>Товары</Item>\r\n\t\t\t\t\t<Type>ViewStatusRepresentation</Type>\r\n\t\t\t\t</AdditionSource>\r\n\t\t\t\t<ContextMenu name=\"ТоварыViewStatusContextMenu\" id=\"18\"/>\r\n\t\t\t\t<ExtendedTooltip name=\"ТоварыViewStatusExtendedTooltip\" id=\"19\"/>\r\n\t\t\t</ViewStatusAddition>\r\n\t\t\t<SearchControlAddition name=\"ТоварыSearchControl\" id=\"20\">\r\n\t\t\t\t<AdditionSource>\r\n\t\t\t\t\t<Item>Товары</Item>\r\n\t\t\t\t\t<Type>SearchControl</Type>\r\n\t\t\t\t</AdditionSource>\r\n\t\t\t\t<ContextMenu name=\"ТоварыSearchControlContextMenu\" id=\"21\"/>\r\n\t\t\t\t<ExtendedTooltip name=\"ТоварыSearchControlExtendedTooltip\" id=\"22\"/>\r\n\t\t\t</SearchControlAddition>\r\n\t\t\t<ChildItems>\r\n\t\t\t\t<InputField name=\"ТоварыКоличество\" id=\"23\">\r\n\t\t\t\t\t<DataPath>Объект.Товары.Количество</DataPath>\r\n\t\t\t\t\t<ContextMenu name=\"ТоварыКоличествоContextMenu\" id=\"24\"/>\r\n\t\t\t\t\t<ExtendedTooltip name=\"ТоварыКоличествоExtendedTooltip\" id=\"25\"/>\r\n\t\t\t\t</InputField>\r\n\t\t\t</ChildItems>\r\n\t\t</Table>\r\n\t\t<Button name=\"Обновить\" id=\"26\">\r\n\t\t\t<CommandName>Form.Command.Обновить</CommandName>\r\n\t\t\t<ExtendedTooltip name=\"ОбновитьExtendedTooltip\" id=\"27\"/>\r\n\t\t</Button>\r\n\t<LabelDecoration name=\"Удаляемое\" id=\"40\"><ContextMenu name=\"УдаляемоеКонтекстноеМеню\" id=\"41\"/><ExtendedTooltip name=\"УдаляемоеРасширеннаяПодсказка\" id=\"42\"/></LabelDecoration>\r\n\t</ChildItems>\r\n\t<Attributes>\r\n\t\t<Attribute name=\"Объект\" id=\"1\">\r\n\t\t\t<Type>\r\n\t\t\t\t<v8:Type>cfg:DataProcessorObject.СохранениеИд</v8:Type>\r\n\t\t\t</Type>\r\n\t\t\t<MainAttribute>true</MainAttribute>\r\n\t\t</Attribute>\r\n\t\t<Attribute name=\"Комментарий\" id=\"2\">\r\n\t\t\t<Title>\r\n\t\t\t\t<v8:item>\r\n\t\t\t\t\t<v8:lang>ru</v8:lang>\r\n\t\t\t\t\t<v8:content>Комментарий</v8:content>\r\n\t\t\t\t</v8:item>\r\n\t\t\t</Title>\r\n\t\t\t<Type>\r\n\t\t\t\t<v8:Type>xs:string</v8:Type>\r\n\t\t\t\t<v8:StringQualifiers>\r\n\t\t\t\t\t<v8:Length>0</v8:Length>\r\n\t\t\t\t\t<v8:AllowedLength>Variable</v8:AllowedLength>\r\n\t\t\t\t</v8:StringQualifiers>\r\n\t\t\t</Type>\r\n\t\t</Attribute>\r\n\t\t</Attributes>\r\n\t<Commands>\r\n\t\t<Command name=\"Обновить\" id=\"1\">\r\n\t\t\t<Title>\r\n\t\t\t\t<v8:item>\r\n\t\t\t\t\t<v8:lang>ru</v8:lang>\r\n\t\t\t\t\t<v8:content>Обновить</v8:content>\r\n\t\t\t\t</v8:item>\r\n\t\t\t</Title>\r\n\t\t\t<Action>ОбновитьОбработка</Action>\r\n\t\t</Command>\r\n\t</Commands>\r\n</Form>"
      }
    }
