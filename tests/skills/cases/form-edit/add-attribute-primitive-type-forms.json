{
  "name": "Типы добавляемых реквизитов: примитивы (голые, (D), регистр, синонимы, fixed) и русские синонимы платформенных типов",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "DataProcessor",
        "name": "Типы"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/DataProcessors/Типы.xml",
        "-FormName": "Форма"
      }
    },
    {
      "script": "form-compile/scripts/form-compile",
      "input": {
        "attributes": [
          {
            "name": "Объект",
            "type": "DataProcessorObject.Типы",
            "main": true
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputPath": "{workDir}/DataProcessors/Типы/Forms/Форма/Ext/Form.xml"
      }
    }
  ],
  "params": {
    "formPath": "DataProcessors/Типы/Forms/Форма/Ext/Form.xml"
  },
  "validatePath": "DataProcessors/Типы/Forms/Форма/Ext/Form.xml",
  "input": {
    "attributes": [
      {
        "name": "Голое",
        "type": "Number"
      },
      {
        "name": "Целое",
        "type": "decimal(8)"
      },
      {
        "name": "Регистр",
        "type": "Decimal(15, 2, nonneg)"
      },
      {
        "name": "СтрФикс",
        "type": "String(9,Fixed)"
      },
      {
        "name": "Дат",
        "type": "Date"
      },
      {
        "name": "Период",
        "type": "СтандартныйПериод"
      },
      {
        "name": "Ид",
        "type": "УникальныйИдентификатор"
      },
      {
        "name": "Ссылка",
        "type": "ЛюбаяСсылка"
      },
      {
        "name": "Список",
        "type": "СписокЗначений"
      }
    ]
  }
}
