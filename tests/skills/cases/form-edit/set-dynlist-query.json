{
  "name": "settings динамического списка: запрос, значение-умолчание поверх иного, отбор по частям (в т.ч. userSettingID auto) — сортировка и прочие настройки остаются",
  "setup": "fixture:modify-form",
  "params": {
    "formPath": "Catalogs/Товары/Forms/ФормаСписка/Ext/Form.xml"
  },
  "input": {
    "attributes": [
      {
        "set": "Список",
        "settings": {
          "query": "ВЫБРАТЬ Т.Ссылка, Т.Наименование, Т.Цена ИЗ Справочник.Товары КАК Т",
          "dynamicDataRead": false
        }
      },
      {
        "set": "Список",
        "settings": {
          "dynamicDataRead": true
        }
      },
      {
        "set": "Список",
        "settings": {
          "filter": [
            "Цена > 100",
            { "field": "Наименование", "op": "<>", "value": "", "userSettingID": "auto" }
          ]
        }
      }
    ]
  },
  "expect": {
    "stdoutContains": [
      "settings.dynamicDataRead → DynamicDataRead",
      "settings.filter → ListSettings/filter"
    ]
  }
}
