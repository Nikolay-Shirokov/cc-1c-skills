{
  "name": "Ошибка: нечисловая длина строки у поля (раньше уходила в XML как есть)",
  "preRun": [
    {
      "script": "skd-compile/scripts/skd-compile",
      "input": { "dataSets": [{ "name": "Основной", "query": "ВЫБРАТЬ 1 КАК Поле1", "fields": ["Поле1: decimal(1,0)"] }] },
      "args": { "-DefinitionFile": "{inputFile}", "-OutputPath": "{workDir}/Template.xml" }
    }
  ],
  "params": { "templatePath": "Template.xml", "operation": "add-field", "value": "Стр: string(abc)" },
  "expectError": "Invalid type 'string(abc)'"
}
