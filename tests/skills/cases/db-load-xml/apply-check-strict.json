{
  "name": "То же с -StrictLog: предупреждение поднимает код возврата",
  "fakePlatform": {
    "log": "﻿Загрузка конфигурации из файлов.\r\n",
    "check": {
      "log": "﻿Проба: Список параметров метода \"Проба_Расчёт\" не соответствует методу \"Расчёт\".\r\n",
      "exit": 1
    }
  },
  "args_extra": [
    "-V8Path",
    "{fakePlatform}",
    "-InfoBasePath",
    "{workDir}/ib",
    "-ConfigDir",
    "{workDir}/src",
    "-Extension",
    "Проба",
    "-StrictLog"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": "will not apply it"
  },
  "noSnapshot": "навык ничего не пишет в рабочий каталог — проверяется постусловие",
  "preRun": [
    {
      "writeFile": {
        "path": "src/Configuration.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MetaDataObject/>"
      }
    }
  ]
}
