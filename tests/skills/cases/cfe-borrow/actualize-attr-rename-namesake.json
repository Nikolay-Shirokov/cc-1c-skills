{
  "name": "Реквизит переименован в источнике, под старым именем создан другой — идём за UUID, упоминания в коде помечены как опасные",
  "setup": "fixture:main-attr-kinds",
  "preRun": [
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Document.Расход.Form.ФормаДокумента",
        "-BorrowMainAttribute": "All"
      }
    },
    {
      "editFile": "Documents/Расход.xml",
      "replace": "<Name>Комментарий</Name>",
      "with": "<Name>Примечание</Name>"
    },
    {
      "script": "meta-edit/scripts/meta-edit",
      "args": {
        "-ObjectPath": "{workDir}/Documents/Расход.xml",
        "-Operation": "add-attribute",
        "-Value": "Комментарий: String(50)"
      }
    },
    {
      "writeFile": {
        "path": "cfe/Documents/Расход/Ext/ObjectModule.bsl",
        "content": "&После(\"ПередЗаписью\")\nПроцедура Тест_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)\n\tКомментарий = СокрЛП(Комментарий);\nКонецПроцедуры\n"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "args_extra": [
    "-Actualize"
  ],
  "expect": {
    "stdoutContains": [
      "renamed: Комментарий -> Примечание",
      "'Комментарий' is still mentioned in the code, and in the source this name now belongs to another object (another Attribute Комментарий of this object) — the code would silently use it; fix by hand: Documents/Расход/Ext/ObjectModule.bsl:3"
    ],
    "fileContains": {
      "file": "cfe/Documents/Расход/Forms/ФормаДокумента/Ext/Form.xml",
      "text": [
        "<DataPath>Объект.Примечание</DataPath>"
      ]
    }
  }
}
