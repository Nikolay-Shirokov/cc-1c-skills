{
  "name": "Форма переименована в источнике в имя, занятое собственной формой расширения: не переименована, своя форма цела",
  "setup": "fixture:main-attr-kinds",
  "preRun": [
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Document.Расход.Form.ФормаДокумента",
        "-BorrowMainAttribute": "All"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/cfe/Documents/Расход.xml",
        "-FormName": "Тест_Форма"
      }
    },
    {
      "editFile": "Documents/Расход/Forms/ФормаДокумента.xml",
      "replace": "<Name>ФормаДокумента</Name>",
      "with": "<Name>Тест_Форма</Name>"
    },
    {
      "editFile": "Documents/Расход.xml",
      "replace": "<Form>ФормаДокумента</Form>",
      "with": "<Form>Тест_Форма</Form>"
    },
    {
      "movePath": {
        "from": "Documents/Расход/Forms/ФормаДокумента.xml",
        "to": "Documents/Расход/Forms/Тест_Форма.xml"
      }
    },
    {
      "movePath": {
        "from": "Documents/Расход/Forms/ФормаДокумента",
        "to": "Documents/Расход/Forms/Тест_Форма"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "args_extra": [
    "-Actualize"
  ],
  "expect": {
    "stdoutContains": [
      "cannot rename: form Тест_Форма already exists in the extension"
    ],
    "fileContains": [
      {
        "file": "cfe/Documents/Расход/Forms/ФормаДокумента.xml",
        "text": [
          "<Name>ФормаДокумента</Name>"
        ]
      },
      {
        "file": "cfe/Documents/Расход/Forms/Тест_Форма.xml",
        "text": [
          "<Name>Тест_Форма</Name>"
        ]
      }
    ],
    "fileNotContains": {
      "file": "cfe/Documents/Расход/Forms/Тест_Форма.xml",
      "text": [
        "Adopted"
      ]
    }
  }
}
