{
  "name": "Документ с ТЧ переименован в источнике: порождённые типы ТЧ следом, следующий элемент пакета — под новым именем",
  "setup": "fixture:main-attr-kinds",
  "preRun": [
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Document.Расход.Form.ФормаДокумента",
        "-BorrowMainAttribute": "All"
      }
    },
    {
      "editFile": "Documents/Расход.xml",
      "replace": "Расход",
      "with": "Отгрузка",
      "all": true
    },
    {
      "editFile": "Documents/Расход/Forms/ФормаДокумента/Ext/Form.xml",
      "replace": "Расход",
      "with": "Отгрузка",
      "all": true
    },
    {
      "editFile": "Documents/Расход/Forms/ФормаСписка/Ext/Form.xml",
      "replace": "Расход",
      "with": "Отгрузка",
      "all": true
    },
    {
      "editFile": "Documents/Расход/Forms/ФормаСпискаЗапрос/Ext/Form.xml",
      "replace": "Расход",
      "with": "Отгрузка",
      "all": true
    },
    {
      "editFile": "Configuration.xml",
      "replace": "Расход",
      "with": "Отгрузка",
      "all": true
    },
    {
      "movePath": {
        "from": "Documents/Расход.xml",
        "to": "Documents/Отгрузка.xml"
      }
    },
    {
      "movePath": {
        "from": "Documents/Расход",
        "to": "Documents/Отгрузка"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "object": "Document.Расход.Form.ФормаДокумента ;; Document.Расход.Attribute.Комментарий",
  "expect": {
    "stdoutContains": [
      "[RENAMED] Document.Расход",
      "renamed: Расход -> Отгрузка",
      "[UP-TO-DATE] Document.Отгрузка.Attribute.Комментарий"
    ],
    "stdoutNotContains": [
      "still mentioned"
    ],
    "fileContains": [
      {
        "file": "cfe/Documents/Отгрузка.xml",
        "text": [
          "<Name>Отгрузка</Name>",
          "DocumentTabularSection.Отгрузка.Товары",
          "DocumentTabularSectionRow.Отгрузка.Товары"
        ]
      },
      {
        "file": "cfe/Configuration.xml",
        "text": [
          "<Document>Отгрузка</Document>"
        ]
      }
    ],
    "fileNotContains": {
      "file": "cfe/Documents/Отгрузка.xml",
      "text": [
        ".Расход"
      ]
    }
  }
}
