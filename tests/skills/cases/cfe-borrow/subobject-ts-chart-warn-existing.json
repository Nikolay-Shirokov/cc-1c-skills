{
  "name": "ТЧ плана видов характеристик, уже заимствованная ради реквизита источника: заимствование ТЧ целиком всё равно предупреждает",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "Catalog",
          "name": "Номенклатура"
        },
        {
          "type": "Document",
          "name": "ЗаказКлиента",
          "attributes": [
            "Комментарий: String(50)"
          ],
          "tabularSections": {
            "Товары": [
              "Номенклатура: CatalogRef.Номенклатура",
              "Количество: Number(15,3)"
            ]
          }
        },
        {
          "type": "InformationRegister",
          "name": "Цены",
          "dimensions": [
            "Номенклатура: CatalogRef.Номенклатура"
          ],
          "resources": [
            "Цена: Number(15,2)"
          ]
        },
        {
          "type": "ChartOfCharacteristicTypes",
          "name": "ВидыСубконто",
          "valueType": "String",
          "tabularSections": {
            "Строки": [
              "Значение: String(20)"
            ]
          }
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "ChartOfCharacteristicTypes.ВидыСубконто.TabularSection.Строки.Attribute.Значение"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe",
    "object": "ChartOfCharacteristicTypes.ВидыСубконто.TabularSection.Строки"
  },
  "expect": {
    "stdoutContains": [
      "[UP-TO-DATE] ChartOfCharacteristicTypes.ВидыСубконто.TabularSection.Строки",
      "[WARN]",
      "own attributes cannot be added"
    ]
  }
}
