{
  "name": "Типы при добавлении: голые, (D), пробелы, регистр, синонимы, fixed, nonneg; ХранилищеЗначения и base64Binary",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Типы",
        "tabularSections": {
          "Товары": [
            "Кол: Number(15,3)"
          ]
        }
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectPath": "Catalogs/Типы"
  },
  "input": {
    "add": {
      "attributes": [
        "Голое: Number",
        "Целое: Число(10)",
        "СПробелом: Number(15, 2)",
        "Регистр: number(15,2,NONNEG)",
        "Дец: decimal(10,nonneg)",
        "Стр: String",
        "СтрФикс: String(9, Fixed)",
        "Дат: DATETIME",
        "Флаг: Number(12,3) | nonneg",
        "Хранилище: ХранилищеЗначения",
        "Двоичные: base64Binary"
      ]
    },
    "modify": {
      "tabularSections": {
        "Товары": {
          "add": [
            "Б: Число(10)",
            "В: Строка(3,fix)"
          ]
        }
      }
    }
  }
}
