{
  "name": "Изменение свойства подсистемы",
  "preRun": [
    {
      "script": "subsystem-compile/scripts/subsystem-compile",
      "input": { "name": "Продажи" },
      "args": { "-DefinitionFile": "{inputFile}", "-OutputDir": "{workDir}" }
    }
  ],
  "params": { "subsystemPath": "Subsystems/Продажи.xml" },
  "input": [
    { "operation": "set-property", "value": "{\"name\":\"IncludeInCommandInterface\",\"value\":\"false\"}" },
    { "operation": "set-property", "value": "{\"name\":\"Comment\",\"value\":\"Раздел продаж\"}" },
    { "operation": "set-property", "value": "{\"name\":\"picture\",\"value\":\"StdPicture.Information\"}" },
    { "operation": "set-property", "value": "{\"name\":\"explanation\",\"value\":\"Документы и отчёты по продажам\"}" },
    { "operation": "set-property", "value": "{\"name\":\"Synonym\",\"value\":null}" }
  ]
}
