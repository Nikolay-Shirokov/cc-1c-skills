{
  "name": "Форма с запросным динамическим списком: проверка пропускается (fake platform)",
  "osOnly": "win32",
  "fakePlatform": {
    "exit": 0,
    "log": "",
    "check": {
      "exit": 101,
      "log": "Не должно быть вызвано\n"
    }
  },
  "preRun": [
    {
      "script": "epf-init/scripts/init",
      "args": {
        "-Name": "Тест",
        "-SrcDir": "{workDir}/src"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/src/Тест.xml",
        "-FormName": "Форма"
      }
    },
    {
      "script": "form-compile/scripts/form-compile",
      "input": {
        "title": "Т",
        "attributes": [
          {
            "name": "Список",
            "type": "DynamicList",
            "main": true,
            "settings": {
              "keyType": "RowNumber",
              "query": "ВЫБРАТЬ Т.Ссылка ИЗ Справочник.С КАК Т"
            }
          }
        ],
        "elements": [
          {
            "table": "Т",
            "path": "Список",
            "columns": [
              {
                "input": "Ссылка",
                "path": "Список.Ссылка"
              }
            ]
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputPath": "{workDir}/src/Тест/Forms/Форма/Ext/Form.xml"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\fake.cmd",
    "-InfoBasePath",
    "{workDir}\\ib",
    "-SourceFile",
    "{workDir}\\src\\Тест.xml",
    "-OutputFile",
    "{workDir}\\build\\Тест.epf"
  ],
  "expect": {
    "stdoutContains": [
      "source check skipped: a form has a dynamic list with a manual query",
      "/LoadExternalDataProcessorOrReportFromFiles"
    ],
    "stdoutNotContains": [
      "/CheckConfig"
    ]
  },
  "expectError": true,
  "noSnapshot": "платформа фейковая, EPF не собирается — проверяется командная строка"
}