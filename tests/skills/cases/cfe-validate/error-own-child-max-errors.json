{
  "name": "Ошибки проверки 10 о собственных подобъектах соблюдают -MaxErrors",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "InformationRegister",
          "name": "Цены",
          "dimensions": [
            "Номенклатура: String(20)"
          ],
          "resources": [
            "Цена: Number(15,2)"
          ]
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-NamePrefix": "Тест_",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "InformationRegister.Цены"
      }
    },
    {
      "script": "meta-edit/scripts/meta-edit",
      "args": {
        "-ObjectPath": "{workDir}/cfe/InformationRegisters/Цены.xml",
        "-Operation": "add-attribute",
        "-Value": "Тест_Первый: String(10) ;; Тест_Второй: String(10)"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "args_extra": [
    "-MaxErrors",
    "1"
  ],
  "expectError": true,
  "noSnapshot": "негативный кейс: навык ничего не пишет, проверяется текст ошибки",
  "expect": {
    "stdoutContains": [
      "own Attribute.Тест_Первый",
      "Stopped after 1 errors"
    ],
    "stdoutNotContains": "own Attribute.Тест_Второй"
  }
}
