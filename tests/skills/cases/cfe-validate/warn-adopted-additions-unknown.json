{
  "name": "Свои движения заимствованного документа — не ошибка (дополнение); неизвестное объявленное свойство, расходящееся с источником, — предупреждение",
  "setup": "fixture:adopted-modes",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "AccumulationRegister",
        "name": "Patch_R",
        "dimensions": [
          "K: String(10)"
        ],
        "resources": [
          "S: Number(10,2)"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "editFile": "Documents/Docs.xml",
      "replace": "<ExtendedConfigurationObject>81a26ce5-f36f-499e-9525-7ec8752b0e8f</ExtendedConfigurationObject>",
      "with": "<ExtendedConfigurationObject>81a26ce5-f36f-499e-9525-7ec8752b0e8f</ExtendedConfigurationObject>\r\n\t\t\t<RegisterRecords>\r\n\t\t\t\t<xr:Item xsi:type=\"xr:MDObjectRef\">AccumulationRegister.Patch_R</xr:Item>\r\n\t\t\t</RegisterRecords>"
    },
    {
      "editFile": "InformationRegisters/Rates.xml",
      "replace": "<InformationRegisterPeriodicity>",
      "with": "<UseStandardCommands>false</UseStandardCommands>\r\n\t\t\t<InformationRegisterPeriodicity>"
    }
  ],
  "params": {
    "extensionPath": "."
  },
  "args_extra": [
    "-ConfigPath",
    "{workDir}/src",
    "-Detailed"
  ],
  "noSnapshot": "навык ничего не пишет, проверяется текст и код возврата",
  "expect": {
    "stdoutContains": [
      "[WARN]  18. InformationRegister.Rates: UseStandardCommands (false) differs from the source configuration (true) — not a known controlled property"
    ],
    "stdoutNotContains": [
      "[ERROR]",
      "RegisterRecords"
    ]
  }
}
