{
  "name": "С -ConfigPath ловится имя заимствованного объекта, отличающееся от источника только регистром",
  "setup": "fixture:adopted-without-link",
  "preRun": [
    {
      "writeFile": {
        "path": "CommonModules/SharedModule.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MetaDataObject xmlns=\"http://v8.1c.ru/8.3/MDClasses\" xmlns:xr=\"http://v8.1c.ru/8.3/xcf/readable\" version=\"2.20\">\n\t<CommonModule uuid=\"ad3f95af-e857-4764-9b25-7651c51b908d\">\n\t\t<Properties>\n\t\t\t<ObjectBelonging>Adopted</ObjectBelonging>\n\t\t\t<Name>SharedModule</Name>\n\t\t\t<ExtendedConfigurationObject>d70b66c6-f632-4b32-ae65-5b5188f0c072</ExtendedConfigurationObject>\n\t\t\t<Server>true</Server>\n\t\t\t<ServerCall>true</ServerCall>\n\t\t</Properties>\n\t</CommonModule>\n</MetaDataObject>\n"
      }
    },
    { "deletePath": "src/CommonModules/SharedModule.xml" },
    {
      "writeFile": {
        "path": "src/CommonModules/sharedModule.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MetaDataObject xmlns=\"http://v8.1c.ru/8.3/MDClasses\" version=\"2.20\">\n\t<CommonModule uuid=\"d70b66c6-f632-4b32-ae65-5b5188f0c072\">\n\t\t<Properties>\n\t\t\t<Name>sharedModule</Name>\n\t\t\t<Server>true</Server>\n\t\t\t<ServerCall>true</ServerCall>\n\t\t</Properties>\n\t</CommonModule>\n</MetaDataObject>\n"
      }
    }
  ],
  "params": { "extensionPath": "." },
  "args_extra": ["-ConfigPath", "{workDir}/src"],
  "expectError": true,
  "noSnapshot": "негативный кейс: навык ничего не пишет, проверяется текст и код возврата",
  "expect": {
    "stdoutContains": "18. CommonModule.SharedModule: the source configuration has this name in a different case (CommonModule.sharedModule)",
    "stdoutNotContains": "missing from the source configuration"
  }
}
