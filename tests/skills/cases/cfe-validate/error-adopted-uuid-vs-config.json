{
  "name": "С -ConfigPath ловится заимствование, чей UUID разошёлся с пересозданным объектом источника — одна ошибка по объекту, без ручной правки UUID",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары",
        "attributes": [
          "Артикул: String(10)"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/Catalogs/Товары.xml",
        "-FormName": "ФормаЭлемента"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Catalog.Товары.Form.ФормаЭлемента",
        "-BorrowMainAttribute": "All"
      }
    },
    {
      "deletePath": "Catalogs/Товары.xml"
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары",
        "attributes": [
          "Артикул: String(10)"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "deletePath": "Catalogs/Товары/Forms"
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/Catalogs/Товары.xml",
        "-FormName": "ФормаЭлемента"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "args_extra": [
    "-ConfigPath",
    "{workDir}"
  ],
  "expectError": true,
  "noSnapshot": "негативный кейс: навык ничего не пишет, проверяется текст и код возврата",
  "expect": {
    "stdoutContains": [
      "18. Catalog.Товары: the source object with this name is a different object (UUID ",
      "is no longer in the source — recreated or deleted. The platform does not apply the extension. Do not edit the UUID by hand or re-borrow: the extension's own data is bound to the old object — ask the user"
    ],
    "stdoutNotContains": [
      "missing from the source configuration",
      "18. Catalog.Товары.Attribute.Артикул:"
    ]
  }
}
