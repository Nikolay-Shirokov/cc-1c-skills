{
  "name": "Начальная страница в одну колонку: формы из <Column> видны в -Section home-page",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonForm", "name": "Главная" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "writeFile": {
        "path": "Ext/HomePageWorkArea.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<HomePageWorkArea xmlns=\"http://v8.1c.ru/8.3/xcf/extrnprops\" xmlns:xr=\"http://v8.1c.ru/8.3/xcf/readable\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" version=\"2.17\">\r\n\t<WorkingAreaTemplate>OneColumn</WorkingAreaTemplate>\r\n\t<Column>\r\n\t\t<Item>\r\n\t\t\t<Form>CommonForm.Главная</Form>\r\n\t\t\t<Height>10</Height>\r\n\t\t\t<Visibility>\r\n\t\t\t\t<xr:Common>true</xr:Common>\r\n\t\t\t</Visibility>\r\n\t\t</Item>\r\n\t</Column>\r\n</HomePageWorkArea>"
      }
    }
  ],
  "args_extra": ["-Section", "home-page"],
  "expect": { "stdoutContains": "CommonForm.Главная" },
  "noSnapshot": "навык только читает — проверяется вывод"
}
