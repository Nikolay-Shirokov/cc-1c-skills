{
  "name": "Доп. аргументы ibcmd доходят до платформы, секрет замаскирован, значение с пробелом — одним токеном без лишних кавычек (fake platform)",
  "preRun": [
    {
      "writeFile": {
        "path": "ibcmd.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\ibcmd.cmd",
    "-InfoBasePath",
    "{workDir}\\ib",
    "-AdditionalIbcmdArguments",
    "--verbose,--token=topsecret,--note=a b"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: infobase create",
      "--verbose --token=topsecret \"--note=a b\"",
      "--token=***"
    ],
    "stdoutNotContains": "\\\"--note"
  },
  "expectError": true,
  "noSnapshot": "проверяется командная строка в stdout, файлов на выходе нет",
  "osOnly": "win32"
}
