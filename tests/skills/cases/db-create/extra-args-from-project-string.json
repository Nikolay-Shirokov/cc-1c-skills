{
  "name": "v8args строкой вместо массива — один аргумент, а не список символов (fake platform)",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n"
      }
    },
    {
      "writeFile": {
        "path": ".v8-project.json",
        "content": "{\n  \"v8path\": \"fake\",\n  \"v8args\": \"/UseHwLicenses+\"\n}\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\fake.cmd",
    "-InfoBasePath",
    "{workDir}\\ib"
  ],
  "expect": {
    "stdoutContains": "/DisableStartupDialogs /UseHwLicenses+",
    "stdoutNotContains": "/ U s e"
  },
  "expectError": true,
  "noSnapshot": "проверяется командная строка в stdout, файлов на выходе нет",
  "cwd": "workDir",
  "osOnly": "win32"
}
