{
  "name": "Регистр бухгалтерии с корреспонденцией",
  "preRun": [
    { "script": "meta-compile/scripts/meta-compile", "input": [{"type": "Catalog", "name": "Организации"}], "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" } }
  ],
  "input": {
    "type": "AccountingRegister",
    "name": "Хозрасчетный",
    "chartOfAccounts": "ChartOfAccounts.Хозрасчетный",
    "correspondence": true,
    "dimensions": ["Организация: CatalogRef.Организации"],
    "resources": ["Сумма: Number(15,2)"],
    "attributes": ["Содержание: String(200)"]
  },
  "validatePath": "AccountingRegisters/Хозрасчетный",
  "expect": {
    "files": ["AccountingRegisters/Хозрасчетный.xml", "AccountingRegisters/Хозрасчетный/Ext/RecordSetModule.bsl"]
  }
}
