{
  "name": "Справочник с разными типами реквизитов",
  "preRun": [
    { "script": "meta-compile/scripts/meta-compile", "input": [{"type": "Catalog", "name": "ФизическиеЛица"}, {"type": "Enum", "name": "СтатусыКонтрагентов", "values": ["Значение1"]}], "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" } }
  ],
  "input": {
    "type": "Catalog",
    "name": "Контрагенты",
    "descriptionLength": 150,
    "attributes": [
      "ИНН: String(12)",
      "ДатаРегистрации: Date",
      "ВремяПриема: Time",
      "МоментСоздания: DateTime",
      "Активен: Boolean",
      "СуммаДоговора: Number(15,2)",
      "Ответственный: CatalogRef.ФизическиеЛица",
      "Статус: EnumRef.СтатусыКонтрагентов",
      "Вложение: ValueStorage",
      "Идентификатор: UUID"
    ]
  },
  "validatePath": "Catalogs/Контрагенты",
  "expect": {
    "files": ["Catalogs/Контрагенты.xml"]
  }
}
