{
  "name": "Задача исполнителя с адресацией",
  "preRun": [
    { "script": "meta-compile/scripts/meta-compile", "input": [{"type": "Catalog", "name": "Пользователи"}, {"type": "Catalog", "name": "РолиИсполнителей"}], "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" } }
  ],
  "input": {
    "type": "Task",
    "name": "ЗадачаИсполнителя",
    "descriptionLength": 200,
    "attributes": ["Важность: String(20)"],
    "addressingAttributes": [
      "Исполнитель: CatalogRef.Пользователи",
      "РольИсполнителя: CatalogRef.РолиИсполнителей"
    ]
  },
  "validatePath": "Tasks/ЗадачаИсполнителя",
  "expect": {
    "files": ["Tasks/ЗадачаИсполнителя.xml", "Tasks/ЗадачаИсполнителя/Ext/ObjectModule.bsl"]
  }
}
