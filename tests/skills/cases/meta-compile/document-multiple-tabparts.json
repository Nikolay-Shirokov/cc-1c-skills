{
  "name": "Документ с несколькими ТЧ и реквизитами",
  "preRun": [
    { "script": "meta-compile/scripts/meta-compile", "input": [{"type": "Catalog", "name": "Валюты"}, {"type": "Catalog", "name": "Контрагенты"}, {"type": "Catalog", "name": "Номенклатура"}, {"type": "Catalog", "name": "Организации"}, {"type": "Catalog", "name": "Склады"}], "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" } }
  ],
  "input": {
    "type": "Document",
    "name": "РеализацияТоваров",
    "attributes": [
      "Организация: CatalogRef.Организации",
      "Контрагент: CatalogRef.Контрагенты",
      "Склад: CatalogRef.Склады",
      "Валюта: CatalogRef.Валюты"
    ],
    "tabularSections": {
      "Товары": [
        "Номенклатура: CatalogRef.Номенклатура",
        "Количество: Number(15,3)",
        "Цена: Number(15,2)",
        "Сумма: Number(15,2)"
      ],
      "Услуги": [
        "Номенклатура: CatalogRef.Номенклатура",
        "Сумма: Number(15,2)"
      ]
    }
  },
  "validatePath": "Documents/РеализацияТоваров",
  "expect": {
    "files": ["Documents/РеализацияТоваров.xml"]
  }
}
