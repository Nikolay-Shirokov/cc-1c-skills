{
  "name": "Определяемый тип — составной",
  "preRun": [
    { "script": "meta-compile/scripts/meta-compile", "input": [{"type": "Catalog", "name": "Контрагенты"}, {"type": "Catalog", "name": "Организации"}], "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" } }
  ],
  "input": {
    "type": "DefinedType",
    "name": "СсылкаНаКонтрагента",
    "comment": "(Демо)",
    "valueType": "CatalogRef.Контрагенты + CatalogRef.Организации + String(150)"
  },
  "validatePath": "DefinedTypes/СсылкаНаКонтрагента",
  "expect": {
    "files": ["DefinedTypes/СсылкаНаКонтрагента.xml"]
  }
}
