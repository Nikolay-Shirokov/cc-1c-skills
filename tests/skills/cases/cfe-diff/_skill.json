{
  "script": "cfe-diff/scripts/cfe-diff",
  "setup": "empty-config",
  "args": [
    { "flag": "-ExtensionPath", "from": "workPath", "field": "extensionPath" },
    { "flag": "-OutFile", "from": "workPath", "field": "outFile", "optional": true }
  ],
  "snapshot": {
    "root": "workDir",
    "normalizeUuids": true
  }
}
