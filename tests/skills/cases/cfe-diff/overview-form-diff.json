{
  "name": "Обзор: правки заимствованной формы деревом в нотации form-info, неизменённая форма одной строкой, -ConfigPath не нужен",
  "setup": "fixture:../../cfe-transfer/fixtures/form-transfer",
  "preRun": [
    {
      "script": "form-add/scripts/form-add",
      "args": { "-ObjectPath": "{workDir}/Catalogs/Items.xml", "-FormName": "ListForm", "-Purpose": "List" }
