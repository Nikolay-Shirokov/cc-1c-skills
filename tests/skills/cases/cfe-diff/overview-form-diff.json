    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": { "-ExtensionPath": "{workDir}/cfe", "-ConfigPath": "{workDir}", "-Object": "Catalog.Items.Form.ListForm" }
    }
  ],
  "params": { "extensionPath": "cfe", "outFile": "report.txt" },
  "args_extra": ["-Mode", "overview"]
}
