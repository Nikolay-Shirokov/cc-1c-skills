{
  "name": "childObjectsOrder=alphabetical: порядок как в дереве Конфигуратора — латиница раньше кириллицы, подчёркивание раньше цифр, регистр не учитывается",
  "setup": "fixture:childobjects-order-key",
  "preRun": [
    { "writeFile": { "path": ".v8-project.json", "content": { "childObjectsOrder": "alphabetical" } } }
