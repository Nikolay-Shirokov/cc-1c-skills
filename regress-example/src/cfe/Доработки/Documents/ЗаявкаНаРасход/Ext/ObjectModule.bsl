// Крупная заявка без обоснования не проходит проверку.
&После("ОбработкаПроверкиЗаполнения")
Процедура дор_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если Сумма > 100000 И Не ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для заявки на сумму свыше 100 000 укажите комментарий.";
		Сообщение.Поле = "Комментарий";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

