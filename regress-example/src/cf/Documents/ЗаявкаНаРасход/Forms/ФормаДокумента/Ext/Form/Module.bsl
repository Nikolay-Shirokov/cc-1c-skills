#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьДоступность();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УстановитьДоступность();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	СменитьСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗаявок.НаСогласовании"));
КонецПроцедуры

&НаКлиенте
Процедура Утвердить(Команда)
	СменитьСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗаявок.Утверждена"));
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	СменитьСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗаявок.Отклонена"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СменитьСтатус(НовыйСтатус)
	ПрежнийСтатус = Объект.Статус;
	Объект.Статус = НовыйСтатус;
	Если Не Записать() Тогда
		Объект.Статус = ПрежнийСтатус;
	КонецЕсли;
КонецПроцедуры

// Команды, которые роли не положены, скрыты; доступность остальных и правка полей — по статусу.
&НаСервере
Процедура УстановитьДоступность()
	Статус = Объект.Статус;
	Администратор = РольДоступна("Администратор");
	Инициатор = Администратор Или РольДоступна("Инициатор");
	Согласующий = Администратор Или РольДоступна("Согласующий");
	Черновик = Не ЗначениеЗаполнено(Статус)
		Или Статус = Перечисления.СтатусыЗаявок.Черновик
		Или Статус = Перечисления.СтатусыЗаявок.Отклонена;
	НаСогласовании = Статус = Перечисления.СтатусыЗаявок.НаСогласовании;

	Элементы.ФормаОтправитьНаСогласование.Видимость = Инициатор;
	Элементы.ФормаУтвердить.Видимость = Согласующий;
	Элементы.ФормаОтклонить.Видимость = Согласующий;

	МожноПравить = Черновик И Инициатор;
	МожноСогласовать = НаСогласовании И Согласующий;

	Элементы.ФормаОтправитьНаСогласование.Доступность = МожноПравить;
	Элементы.ФормаУтвердить.Доступность = МожноСогласовать;
	Элементы.ФормаОтклонить.Доступность = МожноСогласовать;
	Элементы.ГруппаШапка.ТолькоПросмотр = Не МожноПравить;
	Элементы.Комментарий.ТолькоПросмотр = Не МожноПравить;
КонецПроцедуры

#КонецОбласти
