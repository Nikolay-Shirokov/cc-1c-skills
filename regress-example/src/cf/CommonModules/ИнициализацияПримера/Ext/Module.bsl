#Область ПрограммныйИнтерфейс

// Наполняет пустую базу примера: пользователи по ролям, подразделения, заявки в разных статусах.
// Вызывается при запуске с параметром /C init; в базе, где пользователи уже есть, ничего не делает.
Процедура НаполнитьБазу() Экспорт
	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	СоздатьПользователя("Администратор", "Администратор");
	СоздатьПользователя("Инициатор", "Инициатор");
	СоздатьПользователя("Согласующий", "Согласующий");
	СоздатьПользователя("Аудитор", "Наблюдатель");

	Бухгалтерия = СоздатьПодразделение("Бухгалтерия");
	Продажи = СоздатьПодразделение("Отдел продаж");

	СоздатьЗаявку(Продажи, 15000, Перечисления.СтатусыЗаявок.Черновик, "Канцелярия");
	СоздатьЗаявку(Бухгалтерия, 42000, Перечисления.СтатусыЗаявок.НаСогласовании, "Обучение сотрудников");
	СоздатьЗаявку(Продажи, 8000, Перечисления.СтатусыЗаявок.Утверждена, "Командировка");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьПользователя(Имя, ИмяРоли)
	Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
	Пользователь.Имя = Имя;
	Пользователь.ПолноеИмя = Имя;
	Пользователь.АутентификацияСтандартная = Истина;
	Пользователь.ПоказыватьВСпискеВыбора = Истина;
	Пользователь.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
	Пользователь.Записать();
КонецПроцедуры

Функция СоздатьПодразделение(Наименование)
	Подразделение = Справочники.Подразделения.СоздатьЭлемент();
	Подразделение.Наименование = Наименование;
	Подразделение.Записать();
	Возврат Подразделение.Ссылка;
КонецФункции

Процедура СоздатьЗаявку(Подразделение, Сумма, Статус, Комментарий)
	Заявка = Документы.ЗаявкаНаРасход.СоздатьДокумент();
	Заявка.Дата = ТекущаяДатаСеанса();
	Заявка.Подразделение = Подразделение;
	Заявка.Сумма = Сумма;
	Заявка.Статус = Статус;
	Заявка.Комментарий = Комментарий;
	Заявка.Записать();
КонецПроцедуры

#КонецОбласти
