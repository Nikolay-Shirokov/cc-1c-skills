// Запуск с параметром /C init наполняет пустую базу примера и закрывает сеанс
// (используется только при сборке базы-источника для эталона).
Процедура ПриНачалеРаботыСистемы()
	Если ПараметрЗапуска = "init" Тогда
		ИнициализацияПримера.НаполнитьБазу();
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
КонецПроцедуры
